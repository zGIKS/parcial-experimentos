@startuml
title EntregaGo — arquitectura DDD en cuatro capas
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam componentStyle rectangle

package "Domain" as Domain #EAF2F8 {
  [Aggregates, entities, value objects] as DomainModel
  interface "Repository ports and PaymentGateway" as DomainPorts
  [OrderPricingPolicy] as PricingPolicy
  DomainModel -right- DomainPorts
  DomainModel -right- PricingPolicy
}
package "Application" as Application #E8F8F5 {
  [ConfirmOrderCommandServiceImpl] as ConfirmService
  [ConfirmOrderCommand / ConfirmOrderResult] as AppContracts
  ConfirmService -down- AppContracts
}
package "Interface" as Interface #FEF9E7 {
  [OrderController] as Controller
  [REST request / response resources] as Resources
  [BusinessRuleExceptionHandler] as ErrorHandler
  Controller -down- Resources
  Controller -right- ErrorHandler
}
package "Infrastructure" as Infrastructure #FDEDEC {
  [InMemoryMarketplaceAdapter] as MemoryAdapter
  [InMemoryPaymentGateway] as PaymentAdapter
  [MarketplaceConfiguration] as Configuration
}
Controller --> ConfirmService : invokes use case
ConfirmService ..> DomainModel : coordinates business behavior
ConfirmService ..> DomainPorts : uses ports
MemoryAdapter ..|> DomainPorts : implements persistence ports
PaymentAdapter ..|> DomainPorts : implements payment port
Configuration ..> PricingPolicy : configures standard policy
@enduml
